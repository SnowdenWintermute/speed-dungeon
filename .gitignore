## top level of monorepo
**/node_modules
**/dist
**/yarn-error.log

# *.css
!main.css
*.css.map

.tsbuildinfo
*.tsbuildinfo
**/*.tsbuildinfo


**/*.env
**/*.env*.local
# deploy env holds real secrets; only the .example template is tracked
.env.deploy
!.env.deploy.example
# box env files (real secrets) use a -env suffix that **/*.env does not catch
.speed-dungeon-env
.battle-school-env
cypress.env.json
*.secrets
**/*.secrets
**/cypress/videos

# mac computers add this to all their folders
**/.DS_Store

# libreoffice writes these next to an open workbook
.~lock.*#

# some xlsx viewers unzip the workbook in place next to it
packages/balance-tools/\[Content_Types\].xml
packages/balance-tools/_rels/
packages/balance-tools/docProps/
packages/balance-tools/xl/

# claude code personal settings
.claude/settings.local.json
packages/balance-tools/saved-runs/
