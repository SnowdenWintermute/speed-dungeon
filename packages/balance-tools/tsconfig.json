{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "jsx": "react-jsx",
    "lib": ["dom", "dom.iterable", "esnext"],
    "moduleResolution": "bundler",
    // the workbook scripts under src/workbook run straight from source under node, which resolves
    // neither the @/ alias nor an extensionless specifier — so their relative imports, and any
    // module they reach, carry a .ts extension. the app code beside them keeps the @/ alias
    "allowImportingTsExtensions": true,
    "types": ["node", "vite/client", "vitest/globals"],
    "paths": {
      "@speed-dungeon/ui/*": ["../ui/src/*"],
      "@/*": ["./src/*"]
    }
  },
  "references": [
    {
      "path": "../common"
    }
  ],
  "include": ["src", "vite.config.ts", "tailwind.config.ts"]
}
