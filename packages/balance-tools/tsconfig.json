{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "jsx": "react-jsx",
    "lib": ["dom", "dom.iterable", "esnext"],
    "moduleResolution": "bundler",
    // relative imports here carry their extension, and no path alias is defined: the workbook
    // scripts run straight from source under node, which resolves neither. one convention for the
    // whole package means nothing has to track which modules those scripts can reach
    "allowImportingTsExtensions": true,
    "types": ["node", "vite/client", "vitest/globals"],
    "paths": {
      "@speed-dungeon/ui/*": ["../ui/src/*"]
    }
  },
  "references": [
    {
      "path": "../common"
    }
  ],
  // ui's svg declaration is ambient, so it has to be in the program rather than merely reachable
  "include": ["src", "vite.config.ts", "tailwind.config.ts", "../ui/src/assets/svg.d.ts"]
}
