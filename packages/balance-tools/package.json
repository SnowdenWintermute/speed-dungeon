  },
  "devDependencies": {
    "@types/lodash.clonedeep": "4.5.9",
    "@types/react": "19.1.9",
    "@types/react-dom": "19.1.7",
    "@vitejs/plugin-react": "^5.0.4",
    "tailwindcss": "3.4.1",
    "typescript": "^5.8.3",
    "vite": "^7.2.4",
    "vite-plugin-node-polyfills": "^0.28.0",
    "vite-plugin-svgr": "^5.2.0",
    "vitest": "^3.1.4"
  }
