{
  "name": "@speed-dungeon/balance-tools",
  "version": "1.0.0",
  "description": "Tuning tables that run real game code against generated builds, and the workbook sync that feeds them",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
