{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "jsx": "react-jsx",
    "lib": ["dom", "dom.iterable", "esnext"],
    "moduleResolution": "bundler",
    "types": ["vite/client", "vitest/globals"],
    "paths": {
      "@speed-dungeon/ui/*": ["../ui/src/*"],
      "@/*": ["./src/*"]
    }
  },
  "references": [
    {
      "path": "../common"
    }
  ],
  "include": ["src", "vite.config.ts", "tailwind.config.ts"]
}
