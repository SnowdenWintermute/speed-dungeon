{
  "extends": "./tsconfig.json",
  // tests are excluded below, so the build has no use for vitest's ambient globals
  "compilerOptions": { "types": ["node"] },
  // a custom exclude replaces TypeScript's default one entirely, so node_modules and the
  // outDir have to be listed again or dist gets globbed back in as input (TS5055)
  "exclude": ["node_modules", "dist", "**/*.test.ts", "**/__tests__/**"]
}
