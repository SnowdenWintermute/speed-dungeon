{
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest watch --reporter=verbose",
    "watch": "concurrently --names build,types --prefix-colors cyan,magenta \"yarn workspace @speed-dungeon/server build:watch\" \"yarn workspace @speed-dungeon/integration-tests checkTs\""
  },
  "devDependencies": {
    "@types/ws": "^8.18.1",
    "concurrently": "9.1.1",
    "@typescript-eslint/eslint-plugin": "^8.33.0",
    "@typescript-eslint/parser": "^8.33.0",
    "dotenv-cli": "^11.0.0",
    "eslint": "^8",
    "eslint-plugin-jsx-a11y": "6.8.0",
    "eslint-plugin-react": "7.34.2",
    "prettier": "*",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3",
    "vitest": "^3.1.4"
  },
  "dependencies": {
    "reflect-metadata": "^0.2.2",
    "ws": "^8.19.0"
  }
}
